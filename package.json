{
  "name": "hramgo",
  "version": "0.1.0",
  "private": true,
  "description": "HramGo: mobile-first православный помощник для поиска храмов РПЦ Москвы.",
  "scripts": {
    "dev": "next dev",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "build": "next build",
    "test": "tsx --test tests/*.test.ts",
    "catalog:sync": "node scripts/sync-catalog.mjs",
    "catalog:refresh": "node scripts/refresh-official.mjs",
    "data:audit": "node scripts/audit-data.mjs",
    "migrate:legacy": "node scripts/migrate-legacy.mjs",
    "db:migrate": "node scripts/apply-migrations.mjs",
    "preview": "node scripts/serve-static.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@supabase/supabase-js": "^2.117.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.24",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "^0.554.0",
    "next": "^15.5.27",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^9.39.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.19",
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.6",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "pg": "^8.23.1",
    "postcss": "^8.5.28",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
